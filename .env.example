# LLM providers, tried in this order; only providers with a key are used.
# If one is rate-limited or down, the request falls back to the next.
LLM_PROVIDERS=gemini,mistral,groq

# Free keys - set at least one
GEMINI_API_KEY=    # https://aistudio.google.com/apikey
MISTRAL_API_KEY=   # https://console.mistral.ai
GROQ_API_KEY=      # https://console.groq.com

# Optional model overrides (defaults: gemini-flash-latest, mistral-small-latest, openai/gpt-oss-20b)
# GEMINI_MODEL=
# MISTRAL_MODEL=
# GROQ_MODEL=

# Save the index of uploaded documents to index_storage/ (set false for a shared public demo)
PERSIST_INDEX=true
